---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description and page.description != ' ' %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% if page.cv_pdf %}
      {% if page.cv_pdf contains '://' %}
        {% assign cv_url = page.cv_pdf %}
      {% else %}
        {% assign cv_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
      {% endif %}
      <p>
        <a href="{{ cv_url }}" target="_blank" rel="noopener noreferrer"> <i class="fa-solid fa-file-pdf"></i> Download CV (PDF) </a>
      </p>
      <div class="cv-embed" style="width: 100%; margin-top: 1rem; overflow: hidden;">
        <iframe src="{{ cv_url }}" style="border: none; width: 100%; height: 800px;"></iframe>
      </div>
      <style>
        @media (max-width: 768px) {
          .cv-embed {
            position: relative;
            width: 100% !important;
            padding-top: 130%; /* approximate letter aspect ratio */
          }
          .cv-embed iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 200%;
            height: 200%;
            transform: scale(0.5);
            transform-origin: top left;
          }
        }
      </style>
    {% endif %}
  </article>
</div>
