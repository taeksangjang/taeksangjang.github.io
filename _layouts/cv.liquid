---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description and page.description != ' ' %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% if page.cv_pdf %}
      {% if page.cv_pdf contains '://' %}
        {% assign cv_url = page.cv_pdf %}
      {% else %}
        {% assign cv_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
      {% endif %}
      <p>
        <a href="{{ cv_url }}" target="_blank" rel="noopener noreferrer"> <i class="fa-solid fa-file-pdf"></i> Download CV (PDF) </a>
      </p>
      {% if page.cv_pdf contains '://' %}
        {% assign cv_full_url = page.cv_pdf %}
      {% else %}
        {% assign cv_full_url = page.cv_pdf | prepend: 'assets/pdf/' | prepend: site.url | append: '/' %}
      {% endif %}
      <div class="cv-embed" style="margin-top: 1rem; overflow: hidden;">
        <iframe src="https://docs.google.com/gview?url={{ cv_full_url }}&embedded=true" style="border: none; width: 100%; height: 1100px;"></iframe>
      </div>
    {% endif %}
  </article>
</div>
