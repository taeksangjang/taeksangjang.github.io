---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description and page.description != ' ' %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% if page.cv_pdf %}
      {% if page.cv_pdf contains '://' %}
        {% assign cv_url = page.cv_pdf %}
      {% else %}
        {% assign cv_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
      {% endif %}
      <p>
        <a href="{{ cv_url }}" target="_blank" rel="noopener noreferrer"> <i class="fa-solid fa-file-pdf"></i> Download CV (PDF) </a>
      </p>
      <div class="cv-embed" style="margin-top: 1rem; overflow: hidden;">
        <iframe src="{{ cv_url }}" style="border: none; width: 800px; height: 1040px;"></iframe>
      </div>
      <script>
        (function () {
          var embed = document.querySelector('.cv-embed');
          var iframe = embed.querySelector('iframe');
          function scaleCV() {
            var containerWidth = embed.clientWidth;
            var iframeWidth = 800;
            if (containerWidth < iframeWidth) {
              var scale = containerWidth / iframeWidth;
              iframe.style.transform = 'scale(' + scale + ')';
              iframe.style.transformOrigin = 'top left';
              embed.style.height = 1040 * scale + 'px';
            } else {
              iframe.style.transform = 'none';
              iframe.style.width = iframeWidth + 'px';
              iframe.style.height = '1040px';
              embed.style.height = 'auto';
            }
          }
          scaleCV();
          window.addEventListener('resize', scaleCV);
        })();
      </script>
    {% endif %}
  </article>
</div>
