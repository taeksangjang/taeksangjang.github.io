---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description and page.description != ' ' %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% if page.cv_pdf %}
      {% if page.cv_pdf contains '://' %}
        {% assign cv_url = page.cv_pdf %}
      {% else %}
        {% assign cv_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
      {% endif %}
      <p>
        <a href="{{ cv_url }}" target="_blank" rel="noopener noreferrer"> <i class="fa-solid fa-file-pdf"></i> Download CV (PDF) </a>
      </p>
      <div style="width: 100%; margin-top: 1rem;">
        <iframe src="{{ cv_url }}" width="100%" height="800px" style="border: none;"></iframe>
      </div>
    {% endif %}
  </article>
</div>
